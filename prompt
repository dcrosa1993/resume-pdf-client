    "website": "URL, optional"
  },

  "summary": "string, optional",

  "experience": [
    {
      "company": "string",
      "position": "string",
      "location": "string, optional",
      "startDate": "string",
      "endDate": "string, optional",
      "description": "string, optional",
      "achievements": [
        "string"
      ],
      "technologies": [
        "string"
      ]
    }
  ],

  "skills": {
    "technical": [
      "string"
    ],
