      "string, optional"
    ]
  },

  "projects": [
    {
      "name": "string",
      "description": "string",
      "technologies": [
        "string, optional"
      ],
      "url": "URL, optional"
    }
  ],

  "education": [
    {
      "institution": "string",
      "degree": "string",
      "fieldOfStudy": "string, optional",
